<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_it_asset" model="ir.module.category">
        <field name="name">Services / IT Assets</field>
        <field name="description">Manage technological assets.</field>
    </record>

    <record id="group_asset_request_user" model="res.groups">
        <field name="name">User Asset Request</field>
        <field name="category_id" ref="module_it_asset" />
    </record>

    <record id="group_asset_request_manager" model="res.groups">
        <field name="name">Manager Asset Request</field>
        <field name="category_id" ref="module_it_asset" />
        <field name="implied_ids" eval="[(4, ref('group_asset_request_user'))]" />
    </record>

</odoo>