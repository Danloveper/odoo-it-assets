<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_asset_request" model="ir.actions.report">
        <field name="name">Asset Request Report</field>
        <field name="model">it.asset.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">it_asset_request.report_template_asset_request</field>
        <field name="report_file">it_asset_request.report_template_asset_request</field>
        <field name="binding_model_id" ref="model_it_asset_request" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_template_asset_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="asset">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-call="it_asset_request.asset_request_details_card" />
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>