<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="it_asset_request_view_tree" model="ir.ui.view">
        <field name="name">it.asset.request.view.tree</field>
        <field name="model">it.asset.request</field>
        <field name="arch" type="xml">
            <list string="Asset Request">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="it_asset_request_view_form" model="ir.ui.view">
        <field name="name">it.asset.request.view.form</field>
        <field name="model">it.asset.request</field>
        <field name="arch" type="xml">
            <form string="Asset Request">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_name" />
                            <field name="employee_email" widget="email" />
                        </group>
                        <group>
                            <field name="request_date" />
                        </group>
                    </group>
                    <group>
                        <group name="asset" string="Asset">
                            <field name="asset_type" />
                            <field name="is_urgent" />
                            <field name="priority" widget="priority" />
                        </group>
                        <group name="approve" string="Approve">
                            <field name="approved_by_id" />
                            <field name="approval_date" />
                        </group>
                    </group>
                    <group>
                        <field name="justification" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="it_asset_request_action" model="ir.actions.act_window">
        <field name="name">Action Asset request</field>
        <field name="res_model">it.asset.request</field>
        <field name="view_mode">list,form,search</field>
    </record>
</odoo>
